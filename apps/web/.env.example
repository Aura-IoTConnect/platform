VITE_API_URL=http://localhost:4000
VITE_WORKERS_URL=http://localhost:8000

# Optional: must match WORKERS_API_TOKEN in apps/workers/.env if that's set.
# NOTE: this ships inside the built browser bundle, so it's a basic abuse
# gate (stops scanners/bots hitting an open CORS endpoint), not real secrecy
# — anyone with devtools on this page can read it. See CLAUDE.md.
VITE_WORKERS_TOKEN=
