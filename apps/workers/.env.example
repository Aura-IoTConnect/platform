DATABASE_URL=postgresql://iotplatform:iotplatform@localhost:5432/iotplatform

# MQTT broker (Mosquitto, see docker-compose.yml). If unreachable at startup,
# MQTT ingestion is disabled and a warning is logged — HTTP ingestion still works.
MQTT_HOST=localhost
MQTT_PORT=1883

# Required for AI agents (anomaly-explainer, alert-triage, automation-suggester).
# Without it, agent endpoints return 503 and telemetry ingestion still works normally.
ANTHROPIC_API_KEY=

# Optional: override the model used for agent calls.
CLAUDE_AGENT_MODEL=claude-sonnet-4-5

# Optional shared-secret bearer token required on /ingestion/* and /agents/*
# HTTP endpoints (generate with: openssl rand -hex 32). Left unset, those
# endpoints are open — fine for local dev, not for anything reachable beyond
# localhost. Set the same value as VITE_WORKERS_TOKEN in apps/web/.env.
WORKERS_API_TOKEN=
