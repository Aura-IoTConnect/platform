DATABASE_URL=postgresql://iotplatform:iotplatform@localhost:5432/iotplatform

# MQTT broker (Mosquitto, see docker-compose.yml). Auth is required — see
# infra/mosquitto.passwd / mosquitto.acl (a single shared credential
# restricted to the telemetry/# topic namespace, generated via
# `mosquitto_passwd`; regenerate it if you're deploying this for real rather
# than running the committed dev default). If the broker is unreachable or
# rejects these credentials at startup, MQTT ingestion is disabled and a
# warning is logged — HTTP ingestion still works.
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USERNAME=iotplatform
MQTT_PASSWORD=ddcf249f65c884a34a81047c76d43d59

# Required for AI agents (anomaly-explainer, alert-triage, automation-suggester).
# Without it, agent endpoints return 503 and telemetry ingestion still works normally.
ANTHROPIC_API_KEY=

# Optional: override the model used for agent calls.
CLAUDE_AGENT_MODEL=claude-sonnet-4-5

# Optional: seconds to suppress a repeat notify/webhook dispatch for the same
# (device, rule) pair after its last notification — flapping protection for
# a metric oscillating around its threshold. Doesn't affect actuator dispatch
# or how often Alert rows are created. See CLAUDE.md's "Alert dedup,
# auto-clear, and notify cooldown" section. Default 300 (5 minutes).
NOTIFY_COOLDOWN_SECONDS=300

# Optional shared-secret bearer token required on /agents/* HTTP endpoints
# (generate with: openssl rand -hex 32) and, as a fallback, on
# /ingestion/telemetry for devices with no per-device API key. Left unset,
# those requests are open — fine for local dev, not for anything reachable
# beyond localhost. Must match WORKERS_API_TOKEN in apps/api/.env, which is
# what apps/api actually sends when it proxies agent triggers server-side —
# this value never reaches the browser.
WORKERS_API_TOKEN=
