DATABASE_URL=postgresql://iotplatform:iotplatform@localhost:5432/iotplatform

# MQTT broker (Mosquitto, see docker-compose.yml). Auth is via Mosquitto's
# dynamic-security plugin (app/mqtt_dynsec.py) — most devices get their own
# provisioned credential (username=device_id), matching the HTTP ingestion
# path's per-device Device.apiKeyHash. MQTT_USERNAME/MQTT_PASSWORD below is
# the shared fallback credential apps/workers' own bridge connects with to
# actually consume messages (it needs telemetry-subscriber, not just
# device-publisher). If the broker is unreachable or rejects these
# credentials at startup, MQTT ingestion is disabled and a warning is
# logged — HTTP ingestion still works. See CLAUDE.md.
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USERNAME=iotplatform
MQTT_PASSWORD=ddcf249f65c884a34a81047c76d43d59

# Optional: dynsec admin credentials, used only for provisioning (createRole/
# createClient/etc — see app/mqtt_dynsec.py), not for the telemetry bridge
# above. Left unset, apps/workers reads the plugin's self-generated bootstrap
# admin password straight out of
# infra/mosquitto-dynsec-state/dynamic-security.json.pw (bind-mounted by
# docker-compose.yml — fine for local dev, since apps/workers runs natively
# on the host and can read that file directly). Set MQTT_DYNSEC_ADMIN_PASSWORD
# if you've rotated that password, or deploying somewhere the .pw file isn't
# reachable; MQTT_DYNSEC_PW_FILE overrides the file path instead of the value.
MQTT_DYNSEC_ADMIN_PASSWORD=
MQTT_DYNSEC_PW_FILE=

# Required for AI agents (anomaly-explainer, alert-triage, automation-suggester).
# Without it, agent endpoints return 503 and telemetry ingestion still works normally.
ANTHROPIC_API_KEY=

# Optional: override the model used for agent calls.
CLAUDE_AGENT_MODEL=claude-sonnet-4-5

# Optional shared-secret bearer token required on /agents/* HTTP endpoints
# (generate with: openssl rand -hex 32) and, as a fallback, on
# /ingestion/telemetry for devices with no per-device API key. Left unset,
# those requests are open — fine for local dev, not for anything reachable
# beyond localhost. Must match WORKERS_API_TOKEN in apps/api/.env, which is
# what apps/api actually sends when it proxies agent triggers server-side —
# this value never reaches the browser.
WORKERS_API_TOKEN=
