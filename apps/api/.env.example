DATABASE_URL="postgresql://iotplatform:iotplatform@localhost:5432/iotplatform"
PORT=4000

# Required. Generate with: openssl rand -hex 32
JWT_SECRET=

# Optional: if set when running `npm run db:seed`, creates/updates this admin
# user. Leave unset on repeat seeds to avoid resetting the password.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# apps/workers base URL, for proxying agent-trigger requests server-side
# (POST /api/agents/{key}/run). Must match apps/workers' WORKERS_API_TOKEN
# if that's set — this value never reaches the browser.
WORKERS_URL=http://localhost:8000
WORKERS_API_TOKEN=
